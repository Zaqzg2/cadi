# Copy to backend/.env for local runs (NEVER commit the real file — .env is git-ignored) or paste each line into your
# host's "Environment variables" screen. Lines starting with # are comments. Nothing here is ever sent to the Android app.

# ---------------------------------------------------------------- required
# A long random string. The Android app sends it in the X-App-Key header (it is the app's BACKEND_APP_KEY build setting).
# Generate one:  openssl rand -base64 32
APP_API_KEY=

# At least ONE of the following AI providers. Free keys: console.mistral.ai, console.groq.com, openrouter.ai/keys
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ---------------------------------------------------------------- optional: AI tuning
# Priority order (comma separated). Default: mistral,groq,openrouter,custom
# AI_PROVIDER_ORDER=mistral,groq,openrouter
# Override a model id without touching code (ids change often on free tiers):
# MISTRAL_TEXT_MODEL=mistral-small-latest
# MISTRAL_VISION_MODEL=mistral-small-latest
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# OPENROUTER_TEXT_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=openrouter/free
# Any other OpenAI-compatible endpoint (all three together):
# CUSTOM_AI_BASE_URL=https://example.com/v1
# CUSTOM_AI_API_KEY=
# CUSTOM_AI_TEXT_MODEL=
# CUSTOM_AI_VISION_MODEL=
# CUSTOM_AI_LABEL=My provider

# ---------------------------------------------------------------- optional: Google Workspace (Drive, Sheets, Docs, Gmail, Calendar)
# Leave all four empty and the AI features still work; the Google endpoints answer GOOGLE_NOT_CONFIGURED.
# The OAuth client must be of type "Web application". TOKEN_ENCRYPTION_KEY seals the Google refresh tokens the phone stores;
# changing it logs every user out of Google. Generate one:  openssl rand -base64 48
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
# GOOGLE_OAUTH_REDIRECT_URI=

# ---------------------------------------------------------------- optional: limits and plumbing
# PORT=8080
# RATE_LIMIT_CHAT_PER_MINUTE=30
# RATE_LIMIT_EXTRACT_PER_MINUTE=6
# RATE_LIMIT_WORKSPACE_PER_MINUTE=20
# DAILY_AI_REQUEST_CAP=1500            # 0 = unlimited. Protects your free provider quota if the app key ever leaks.
# MAX_UPLOAD_BYTES=10485760
# PROVIDER_TIMEOUT_SECONDS=40
# AI_TOTAL_TIMEOUT_SECONDS=100
# TRUST_PROXY_HEADERS=true             # set false only when the server is exposed directly, with no proxy in front
# CORS_ALLOWED_HOSTS=                  # only needed if a browser-based admin page is ever added

# Local development ONLY (never on a public server): skip the X-App-Key check.
# APP_AUTH_DISABLED=true
