<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Phases 1-3 were fully offline by design. Phase 4 adds real network calls: to this app's own
      backend (the default path for the assistant, document import and Google Workspace) and - only when the
      user turns on "use my own keys" in Settings - directly to Gemini / Mistral / Groq / OpenRouter / OCR.space. So INTERNET is required.
      Deliberately NOT added: CAMERA and any storage permission. Photo capture is delegated to the
      system camera app (ACTION_IMAGE_CAPTURE through a FileProvider) and barcode scanning to Google
      Play services' code scanner, neither of which needs the app to hold the CAMERA permission;
      the file picker (SAF) needs no storage permission either.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Daily stock alerts (near expiry / low stock). Runtime-granted on Android 13+; the alerts switch asks for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".InventorySmartApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InventorySmartAI"
        tools:targetApi="31">

        <!-- Pre-downloads Google's barcode-scanner module at install time. Without it the module is
             fetched on the first scan, which fails offline / on devices where Play services is
             still updating — the scan screen then never opens and nothing seems to happen. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode_ui" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.InventorySmartAI"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- «فتح بواسطة»: يظهر التطبيق عند فتح ملف Excel / CSV / PDF / صورة من مدير الملفات أو واتساب أو البريد. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- «مشاركة»: يظهر التطبيق في قائمة المشاركة لملف واحد أو عدة ملفات (يُستورد أولها). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="text/csv" />
                <data android:mimeType="text/comma-separated-values" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- Lets the system camera app save a captured photo into this app's cache (import via camera). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
